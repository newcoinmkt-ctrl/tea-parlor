{
  "name": "@tea-parlor/colyseus-game-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Colyseus multiplayer game server for Tea Parlor (authoritative rooms)",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test tests/*.test.js",
    "smoke:dual": "node scripts/dual-session-smoke.mjs",
    "test:fin3c": "node --test tests/dual-session.test.js tests/trustee-authoritative.test.js && node scripts/dual-session-smoke.mjs"
  },
  "dependencies": {
    "@colyseus/ws-transport": "^0.15.3",
    "@tea-parlor/session-auth": "file:../../packages/session-auth",
    "colyseus": "^0.15.26",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "@tea-parlor/mahjong-engine": "file:../../packages/mahjong-engine",
    "@tea-parlor/guandan-engine": "file:../../packages/guandan-engine"
  },
  "engines": {
    "node": ">=18"
  }
}
