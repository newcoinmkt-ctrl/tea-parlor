{
  "compilerOptions": {
    "types": ["node"],
    "module": "commonjs",
    "target": "es2017",
    "lib": ["es2015", "es2016", "es2017", "DOM"],
    "noImplicitAny": false,
    "noImplicitThis": false,
    "inlineSourceMap": true,
    "newLine": "lf",
    "rootDirs": ["."],
    "outDir": "./dist",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": ["./**/*.ts"],
  "exclude": ["./dist/**/*"]
}
